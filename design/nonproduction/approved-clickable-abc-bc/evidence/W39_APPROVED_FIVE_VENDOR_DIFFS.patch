+        as-child
+      >
+        <Button variant="ghost" class="cn-dialog-close" size="icon-sm">
+          <XIcon class="size-4" aria-hidden="true" />
+          <span class="sr-only">Close</span>
+        </Button>
+      </DialogClose>
+    </DialogContent>
+  </DialogPortal>
