{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "Yance V2 B+C Isolated Candidate",
    "version":  "0.1.1",
    "identifier":  "com.yance.v2.bc-isolated-candidate",
    "build":  {
                  "frontendDist":  "../renderer-bc"
              },
    "app":  {
                "windows":  [

                            ],
                "security":  {
                                 "csp":  {
                                             "default-src":  "\u0027self\u0027",
                                             "script-src":  "\u0027self\u0027",
                                             "style-src":  "\u0027self\u0027 \u0027unsafe-inline\u0027",
                                             "img-src":  "\u0027self\u0027 data: blob:",
                                             "font-src":  "\u0027self\u0027 data:",
                                             "connect-src":  "\u0027self\u0027 ipc: http://ipc.localhost",
                                             "worker-src":  "\u0027none\u0027"
                                         }
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  [
                                   "nsis"
                               ],
                   "windows":  {
                                   "nsis":  {
                                                "installMode":  "currentUser"
                                            }
                               }
               }
}